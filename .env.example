# Copy these into your host's environment variables (not into the code).
ADMIN_EMAIL=you@yourdomain.co.uk
ADMIN_PASSWORD=choose-a-long-password-123      # only needed the first time; remove afterwards
ADMIN_PATH=admin                                # change to something private, e.g. ser-office-7731
TRUST_PROXY=1                                   # set to 1 when behind Railway/Render/Cloudflare (HTTPS proxy)
RESEND_API_KEY=                                 # from resend.com – enables the automatic emails
DATA_DIR=/data                                  # a persistent volume/disk
TZ=Europe/London
PORT=3000
